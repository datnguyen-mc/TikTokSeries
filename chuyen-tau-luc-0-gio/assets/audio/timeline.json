{
  "title": "CHUYẾN TÀU LÚC 0 GIỜ — Tập 1: Quy Tắc Toa Số 4",
  "fps": 30,
  "width": 1080,
  "height": 1920,
  "duration": 30.0,
  "scenes": [
    {
      "id": "scene_01",
      "index": 1,
      "speaker": "Hoàng",
      "text": "Đừng bao giờ bước lên toa số bốn của chuyến tàu điện lúc không giờ.",
      "start": 0.0,
      "vocal_start": 0.642,
      "vocal_end": 3.529,
      "end": 4.278,
      "duration": 4.278
    },
    {
      "id": "scene_02",
      "index": 2,
      "speaker": "Hoàng",
      "text": "Tăng ca về muộn, tôi ngủ gật rồi bước nhầm vào toa tàu vắng tanh.",
      "start": 4.278,
      "vocal_start": 4.706,
      "vocal_end": 7.798,
      "end": 8.44,
      "duration": 4.162
    },
    {
      "id": "scene_03",
      "index": 3,
      "speaker": "Hoàng",
      "text": "Đúng không giờ một phút, điện thoại rung bần bật dù mất sạch sóng.",
      "start": 8.44,
      "vocal_start": 9.189,
      "vocal_end": 12.06,
      "end": 12.702,
      "duration": 4.262
    },
    {
      "id": "scene_04",
      "index": 4,
      "speaker": "Số Lạ",
      "text": "Tuyệt đối đừng nhìn vào tấm kính đối diện. Họ đang đứng ngay sau lưng anh.",
      "start": 12.702,
      "vocal_start": 13.237,
      "vocal_end": 17.57,
      "end": 18.319,
      "duration": 5.617
    },
    {
      "id": "scene_05",
      "index": 5,
      "speaker": "Hoàng",
      "text": "Theo phản xạ, tôi lỡ ngước mắt nhìn thẳng vào tấm kính đen trước mặt.",
      "start": 18.319,
      "vocal_start": 18.747,
      "vocal_end": 21.885,
      "end": 22.527,
      "duration": 4.209
    },
    {
      "id": "scene_06",
      "index": 6,
      "speaker": "Hoàng",
      "text": "Sau lưng tôi trống rỗng... Thứ đang mỉm cười trong kính, chính là tôi.",
      "start": 22.527,
      "vocal_start": 23.063,
      "vocal_end": 27.538,
      "end": 30.0,
      "duration": 7.473
    }
  ],
