", "Cháu cứ làm. Cô đọc nốt chương này."]]}, {"id": "14-05", "scene": "14", "name": "Mua truyện ở đây", "secs": 5, "existing": null, "dl": [[0.3, 2.7, "Anh Thắng", "Hồi bé cháu cũng mua truyện ở đây đấy cô."]]}, {"id": "14-06", "scene": "14", "name": "Đọc chùa nhiều", "secs": 4, "existing": null, "dl": [[0.3, 1.5, "Cô Lan", "Mua ít, đọc chùa nhiều."]]}, {"id": "14-07", "scene": "14", "name": "Người làng", "secs": 4, "existing": null, "dl": []}, {"id": "14-08", "scene": "14", "name": "Một câu", "secs": 4, "existing": null, "dl": [[0.3, 1.7, "Tùng", "Anh nói một câu, máy chạy."]]}, {"id": "14-09", "scene": "14", "name": "Khang nhìn", "secs": 4, "existing": null, "dl": []}, {"id": "14-10", "scene": "14", "name": "Ghế thứ hai", "secs": 4, "existing": null, "dl": []}, {"id": "14-11", "scene": "14", "name": "Ngồi cạnh", "secs": 4, "existing": null, "dl": []}, {"id": "15-01", "scene": "15", "name": "Hai cái ghế", "secs": 4, "existing": null, "dl": []}, {"id": "15-02", "scene": "15", "name": "Tắt máy", "secs": 4, "existing": null, "dl": [[0.3, 1.3, "Khang", "Anh Thắng, tắt máy."]]}, {"id": "15-03", "scene": "15", "name": "Ai trả tiền", "secs": 5, "existing": null, "dl": [[0.3, 2.2, "Anh Thắng", "Thế ai trả tiền ca máy hôm nay?"]]}, {"id": "15-04", "scene": "15", "name": "Tôi", "secs": 4, "existing": null, "dl": [[0.3, 1.1, "Khang", "Tôi."]]}, {"id": "15-05", "scene": "15", "name": "Máy tắt", "secs": 4, "existing": null, "dl": []}, {"id": "15-06", "scene": "15", "name": "Đi ăn sáng", "secs": 5, "existing": null, "dl": [[0.3, 2.4, "Anh Thắng", "Thế thì cháu đi ăn sáng đã cô nhé."]]}, {"id": "15-07", "scene": "15", "name": "Người làng xì xào", "secs": 4, "existing": null, "dl": []}, {"id": "15-08", "scene": "15", "name": "Anh biết không", "secs": 5, "existing": null, "dl": [[0.3, 2.0, "Tùng", "Anh biết anh vừa làm gì không?"]]}, {"id": "15-09", "scene": "15", "name": "Lần đầu", "secs": 4, "existing": null, "dl": [[0.3, 1.7, "Khang", "Biết. Lần đầu sau mười năm."]]}, {"id": "15-10", "scene": "15", "name": "Mai trong đám đông", "secs": 4, "existing": null, "dl": []}, {"id": "15-11", "scene": "15", "name": "Chương này hay", "secs": 4, "existing": null, "dl": [[0.3, 1.3, "Cô Lan", "Chương này hay đấy."]]}, {"id": "15-12", "scene": "15", "name": "Bên kia", "secs": 4, "existing": null, "dl": [[0.3, 1.1, "Tùng", "Bên kia."]]}, {"id": "16-01", "scene": "16", "name": "Áp điện thoại vào ngực", "secs": 4, "existing": null, "dl": [[0.3, 1.7, "Tùng", "Họ hỏi máy đã vào chưa."]]}, {"id": "16-02", "scene": "16", "name": "Không xây ở đây", "secs": 7, "existing": null, "dl": [[0.3, 3.9, "Khang", "Nói với họ: kho phía Bắc không xây ở đây. Giá thế nào thì thế."]]}, {"id": "16-03", "scene": "16", "name": "Họ sẽ rút", "secs": 4, "existing": null, "dl": [[0.3, 1.1, "Tùng", "Họ sẽ rút."]]}, {"id": "16-04", "scene": "16", "name": "Để họ rút", "secs": 4, "existing": null, "dl": [[0.3, 1.3, "Khang", "Thì để họ rút."]]}, {"id": "16-05", "scene": "16", "name": "Im lặng", "secs": 4, "existing": null, "dl": []}, {"id": "16-06", "scene": "16", "name": "Em tính rồi", "secs": 6, "existing": null, "dl": [[0.3, 3.4, "Tùng", "Anh biết không, em tính rồi. Bỏ kho này đi, mình vẫn lãi."]]}, {"id": "16-07", "scene": "16", "name": "Chưa ai dám", "secs": 5, "existing": null, "dl": [[0.3, 2.2, "Tùng", "Chỉ là chưa ai dám nói với anh."]]}, {"id": "16-08", "scene": "16", "name": "Cậu", "secs": 4, "existing": null, "dl": [[0.3, 1.1, "Khang", "Cậu…"]]}, {"id": "16-09", "scene": "16", "name": "Gọi về nhà", "secs": 6, "existing": null, "dl": [[0.3, 3.4, "Tùng", "Bố về muộn tí. Ừ, chủ nhật bố đi xem con đá bóng."]]}, {"id": "16-10", "scene": "16", "name": "Chín giờ mai", "secs": 5, "existing": null, "dl": [[0.3, 2.7, "Tùng", "Vâng, chín giờ sáng mai. Chủ tịch sẽ có mặt."]]}, {"id": "16-11", "scene": "16", "name": "Tự nói", "secs": 5, "existing": null, "dl": [[0.3, 2.0, "Tùng", "Ký hay không, mai anh tự nói."]]}, {"id": "17-01", "scene": "17", "name": "Túi vải trên mâm", "secs": 4, "exis