": "Đọc sách dưới nắng", "secs": 15, "existing": "canh-01_clip-4.mp4", "dl": []}, {"id": "03-02", "scene": "03", "name": "Đọc chùa", "secs": 5, "existing": null, "dl": [[0.3, 2.2, "Cô Lan lúc trẻ", "Đọc chùa ba chiều rồi đấy. Mua không?"]]}, {"id": "03-03", "scene": "03", "name": "Thiếu ba nghìn", "secs": 4, "existing": null, "dl": [[0.3, 1.5, "Khang lúc trẻ", "Cháu… thiếu ba nghìn ạ."]]}, {"id": "03-04", "scene": "03", "name": "Đọc nốt chương", "secs": 5, "existing": null, "dl": [[0.3, 2.0, "Cô Lan lúc trẻ", "Thế đọc nốt chương này rồi về."]]}, {"id": "03-05", "scene": "03", "name": "Ôm sách đứng dậy", "secs": 4, "existing": null, "dl": []}, {"id": "03-06", "scene": "03", "name": "Cô giữ cho cháu", "secs": 6, "existing": null, "dl": [[0.3, 3.4, "Khang lúc trẻ", "Cô ơi, cô giữ cuốn này cho cháu mấy hôm được không ạ?"]]}, {"id": "03-07", "scene": "03", "name": "Giữ đến bao giờ", "secs": 4, "existing": null, "dl": [[0.3, 1.3, "Cô Lan lúc trẻ", "Giữ đến bao giờ?"]]}, {"id": "03-08", "scene": "03", "name": "Đủ tiền", "secs": 4, "existing": null, "dl": [[0.3, 1.5, "Khang lúc trẻ", "Đến khi cháu đủ tiền."]]}, {"id": "03-09", "scene": "03", "name": "Viết giấy nợ", "secs": 4, "existing": null, "dl": [[0.3, 1.5, "Cô Lan lúc trẻ", "Cầm về. Viết giấy nợ."]]}, {"id": "03-10", "scene": "03", "name": "Tay viết", "secs": 4, "existing": null, "dl": []}, {"id": "03-11", "scene": "03", "name": "Ghim lên tường", "secs": 5, "existing": null, "dl": [[0.3, 1.7, "Cô Lan lúc trẻ", "Bao giờ thành người thì trả."]]}, {"id": "03-12", "scene": "03", "name": "Chạy ra nắng", "secs": 4, "existing": null, "dl": [[0.3, 1.5, "Khang lúc trẻ", "Cháu cảm ơn cô ạ!"]]}, {"id": "04-01", "scene": "04", "name": "Đổ ve chai", "secs": 4, "existing": null, "dl": []}, {"id": "04-02", "scene": "04", "name": "Đếm tiền", "secs": 4, "existing": null, "dl": [[0.3, 1.5, "Khang lúc trẻ", "Hai trăm… hai trăm mốt…"]]}, {"id": "04-03", "scene": "04", "name": "Bà ở cửa", "secs": 4, "existing": null, "dl": [[0.3, 1.7, "Bà 