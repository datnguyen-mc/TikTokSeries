", "Ừ. Quà về. Người thì không."]]}, {"id": "06-09", "scene": "06", "name": "Hàng hộp đỏ", "secs": 5, "existing": null, "dl": []}, {"id": "06-10", "scene": "06", "name": "Khang đứng lặng", "secs": 4, "existing": null, "dl": []}, {"id": "06-11", "scene": "06", "name": "Bụi trên tay", "secs": 4, "existing": null, "dl": []}, {"id": "06-12", "scene": "06", "name": "Rửa tay", "secs": 5, "existing": null, "dl": [[0.3, 2.0, "Bà Hạnh", "Vào mà rửa tay. Cơm sắp chín."]]}, {"id": "07-01", "scene": "07", "name": "Dán thùng", "secs": 7, "existing": null, "dl": [[0.3, 3.9, "Cô Lan", "Đóng cửa rồi. Ai cần sách thì cứ lấy, để máy ủi nó cũng phí."]]}, {"id": "07-02", "scene": "07", "name": "Cô Lan", "secs": 4, "existing": null, "dl": [[0.3, 1.1, "Khang", "Cô Lan."]]}, {"id": "07-03", "scene": "07", "name": "Thằng đọc chùa", "secs": 5, "existing": null, "dl": [[0.3, 2.0, "Cô Lan", "Khang đấy à? Cái thằng đọc chùa."]]}, {"id": "07-04", "scene": "07", "name": "Cháu đây", "secs": 4, "existing": null, "dl": [[0.3, 1.1, "Khang", "Vâng. Cháu đây."]]}, {"id": "07-05", "scene": "07", "name": "Trả nợ", "secs": 4, "existing": null, "dl": [[0.3, 1.3, "Khang", "Cháu về trả nợ."]]}, {"id": "07-06", "scene": "07", "name": "Hất hàm", "secs": 4, "existing": null, "dl": []}, {"id": "07-07", "scene": "07", "name": "Giấy nợ trên tường", "secs": 4, "existing": null, "dl": []}, {"id": "07-08", "scene": "07", "name": "Lãi hai lăm năm", "secs": 5, "existing": null, "dl": [[0.3, 2.4, "Cô Lan", "Ba nghìn. Lãi hai lăm năm, cháu tự tính."]]}, {"id": "07-09", "scene": "07", "name": "Chạm tờ giấy", "secs": 4, "existing": null, "dl": []}, {"id": "07-10", "scene": "07", "name": "Máy ủi của công ty cháu", "secs": 6, "existing": null, "dl": [[0.3, 3.6, "Cô Lan", "Mà về đúng lúc đấy. Sáng mai máy ủi của công ty cháu vào."]]}, {"id": "07-11", "scene": "07", "name": "Cô biết", "secs": 4, "existing": null, "dl": []}, {"id": "07-12", "scene": "07", "name": "Cả làng biết", "secs": 5, "existing": null, "dl": [[0.3, 2.7, "Cô Lan", "Cả làng biết. Chỉ có ông chủ là không biết."]]}, {"id": "08-01", "scene": "08", "name": "Mai bước vào", "secs": 4, "existing": null, "dl": []}, {"id": "08-02", "scene": "08", "name": "Cô giữ cho cháu", "secs": 6, "existing": null, "dl": [[0.3, 3.4, "Mai", "Cô ơi, cô giữ cuốn này cho cháu mấy hôm được không ạ?"]]}, {"id": "08-03", "scene": "08", "name": "Đóng cửa rồi", "secs": 4, "existing": null, "dl": [[0.3, 1.5, "Cô Lan", "Mai đóng cửa rồi cháu."]]}, {"id": "08-04", "scene": "08", "name": "Trả dần", "secs": 5, "existing": null, "dl": [[0.3, 2.2, "Mai", "Thế cô bán cho cháu, cháu trả dần."]]}, {"id": "08-05", "scene": "08", "name": "Có đứa nói rồi", "secs": 6, "existing": null, "dl": [[0.3, 2.9, "Cô Lan", "Câu này… hai mươi lăm năm trước có đứa nói rồi."]]}, {"id": "08-06", "scene": "08", "name": "Khang nghe", "secs": 4, "existing": null, "dl": []}, {"id": "08-07", "scene": "08", "name": "Đếm lại", "secs": 4, "existing": null, "dl": [[0.3, 1.7, "Mai", "Mười tám… mười chín… thiếu à?"]]}, {"id": "08-08", "scene": "08", "name": "Cuốn sách xanh", "secs": 4, "existing": null, "dl": []}, {"id": "08-09", "scene": "08", "name": "Chú nhường cháu", "secs": 6, "existing": null, "dl": [[0.3, 2.9, "Mai", "Chú cũng mua sách à? Chú nhường cháu cuốn này nhé."]]}, {"id": "08-10", "scene": "08", "name": "Cháu cầm đi", "secs": 4, "existing": null, "dl": [[0.3, 1.3, "Khang", "Ừ. Cháu cầm đi."]]}, {"id": "08-11", "scene": "08", "name": "Viết giấy nợ", "secs": 4, "existing": null, "dl": [[0.3, 1.5, "Cô Lan", "Cầm về. Viết giấy nợ."]]}, {"id": "08-12", "scene": "08", "name": "Viết ngay", "secs": 4, "existing": null, "dl": [[0.3, 1.1, "Mai", "Cháu viết ngay!"]]}, {"id": "09-01", "scene": "09", "name": "Đạp xe ve chai", "secs": 4, "existing": null, "dl": []}, {"id": "09-02", "scene": "09", "name": "Đợi chú", "secs": 4, "existing": null, "dl": [[0.3, 1.5, "Khang", "Cháu ơi, đợi chú với."]]}, {"id": "09-03", "scene": "09", "name": "Không bán", "secs": 5, "existing": null, "dl": [[0.3, 2.4, "Mai", "Chú định mua lại sách à? Không bán đâu."]]}, {"id": "09-04", "scene": "09", "name": "Đỗ đại học", "secs": 6, "existing": null, "dl": [[0.3, 2.9, "Mai", "Cháu đỗ đại học ngành máy tính. Thứ Hai nhập học."]]}, {"id": "09-05", "scene": "09", "name": "Còn thiếu", "secs": 5, "existing": null, "dl": [[0.3, 2.4, "Mai", "Còn thiếu tiền vé với học phí kỳ đầu."]]}, {"id": "09-06", "scene": "09", "name": "Sao không vay", "secs": 4, "existing": null, "dl": [[0.3, 1.1, "Khang", "Sao không vay?"]]}, {"id": "09-07", "scene": "09", "name": "Ve chai thì không", "secs": 5, "existing": null, "dl": [[0.3, 2.2, "Mai", "Vay thì phải trả. Ve chai thì không."]]}, {"id": "09-08", "scene": "09", "name": "Khang bật cười", "secs": 4, "existing": null, "dl": []}, {"id": "09-09", "scene": "09", "name": "Chỗ đọc sách", "secs": 6, "existing": null, "dl": [[0.3, 3.6, "Mai", "Cả làng có mỗi chỗ đọc sách không mất tiền, thế mà nó ủi."]]}, {"id": "09-10", "scene": "09", "name": "Ông chủ chưa đọc", "secs": 6, "existing": null, "dl": [[0.3, 3.6, "Mai", "Ông chủ cái công ty kho ấy chắc cả đời chưa đọc quyển nào."]]}, {"id": "09-11", "scene": "09", "name": "Khang nhăn mặt", "secs": 4, "existing": null, "dl": []}, {"id": "09-12", "scene": "09", "name": "Chú tên gì", "secs": 4, "existing": null, "dl": [[0.3, 1.3, "Mai", "Mà chú tên gì?"]]}, {"id": "09-13", "scene": "09", "name": "Khang", "secs": 4, "existing": null, "dl": [[0.3, 1.1, "Khang", "Khang."]]}, {"id": "09-14", "scene": "09", "name": "Xui nhỉ", "secs": 5, "existing": null, "dl": [[0.3, 2.4, "Mai", "Trùng tên ông chủ công ty đấy. Xui nhỉ."]]}, {"id": "10-01", "scene": "10", "name": "Gỡ khăn phủ", "secs": 4, "existing": null, "dl": []}, {"id": "10-02", "scene": "10", "name": "Năm lũ", "secs": 4, "existing": null, "dl": [[0.3, 1.5, "Bà Hạnh", "Còn nhớ năm lũ không?"]]}, {"id": "10-03", "scene": "10", "name": "Nước tràn", "secs": 4, "existing": null, "dl": []}, {"id": "10-04", "scene": "10", "name": "Ổ cứng trước", "secs": 5, "existin