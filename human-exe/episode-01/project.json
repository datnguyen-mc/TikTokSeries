  "captions": [
    {
      "start": 0,
      "end": 1.85,
      "text": "Ben automated his entire job."
    },
    {
      "start": 1.92,
      "end": 2.72,
      "text": "By Monday,"
    },
    {
      "start": 2.775,
      "end": 4.7,
      "text": "he was working twelve minutes a day."
    },
    {
      "start": 4.768,
      "end": 5.68,
      "text": "By Friday,"
    },
    {
      "start": 5.734,
      "end": 7.76,
      "text": "his boss wanted to know his secret."
    },
    {
      "start": 7.808,
      "end": 9.04,
      "text": "That was the problem."
    },
    {
      "start": 9.098,
      "end": 10.36,
      "text": "Three weeks earlier,"
    },
    {
      "start": 10.413,
      "end": 13.62,
      "text": "Ben's job had been moving information between rectangles."
    },
    {
      "start": 13.684,
      "end": 15.65,
      "text": "An email became a spreadsheet."
    },
    {
      "start": 15.711,
      "end": 17.61,
      "text": "The spreadsheet became a report."
    },
    {
      "start": 17.671,
      "end": 20.925,
      "text": "The report became a presentation explaining the spreadsheet."
    }
  ],
