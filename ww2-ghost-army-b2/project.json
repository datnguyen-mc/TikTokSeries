  "captions": [
    {
      "start": 0.35,
      "end": 2.94,
      "text": "Năm 1944 ở bờ biển Anh,"
    },
    {
      "start": 3.02,
      "end": 3.89,
      "text": "hai người lính Mỹ"
    },
    {
      "start": 3.89,
      "end": 4.98,
      "text": "nhấc bổng chiếc xe tăng"
    },
    {
      "start": 4.98,
      "end": 6.2,
      "text": "nặng bốn mươi tấn!"
    },
    {
      "start": 6.74,
      "end": 7.78,
      "text": "Thực ra chiếc xe đó"
    },
    {
      "start": 7.78,
      "end": 9.35,
      "text": "chỉ là phao cao su!"
    },
    {
      "start": 9.8,
      "end": 11.04,
      "text": "Đó là Đạo quân Ma,"
    },
    {
      "start": 11.1,
      "end": 12.5,
      "text": "gồm một nghìn họa sĩ,"
    },
    {
      "start": 12.6,
      "end": 14.15,
      "text": "kỹ sư và diễn viên."
    },
    {
      "start": 14.64,
      "end": 16.28,
      "text": "Họ bơm hàng trăm xe giả,"
    },
    {
      "start": 16.35,
      "end": 17.62,
      "text": "phát sóng vô tuyến mồi,"
    },
    {
      "start": 17.7,
      "end": 18.82,
      "text": "bật loa vang cả đêm"
    },
    {
      "start": 18.82,
      "end": 20.25,
      "text": "xa hai mươi cây số."
    },
    {
      "start": 20.8,
      "end": 22.24,
      "text": "Trinh sát Đức mắc bẫy,"
    },
    {
      "start": 22.3,
      "end": 23.48,
      "text": "dồn quân giữ Calais,"
    },
    {
      "start": 23.58,
      "end": 24.4,
      "text": "giúp quân Đồng minh"
    },
    {
      "start": 24.4,
      "end": 25.95,
      "text": "đổ bộ bờ biển Normandy,"
    },
    {
      "start": 26.05,
      "end": 27.02,
      "text": "xoay chuyển cục diện"
    },
    {
      "start": 27.02,
      "end": 28.55,
      "text": "Thế chiến thứ hai!"
    }
  ],
